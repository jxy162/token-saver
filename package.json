{
  "name": "token-saver",
  "version": "0.1.0",
  "description": "面向各类 AI harness 的 token 降耗技能包（编码、脚本与校准工具）",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
